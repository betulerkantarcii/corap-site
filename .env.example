# Copy to .env.local (local) or add in Vercel → Settings → Environment Variables.
# Never commit real keys.

# Public address of the site (used for SEO links and structured data)
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Newsletter: leave empty to use the built-in stub (logs only, sends nothing)
# NEWSLETTER_PROVIDER=brevo        # or: mailchimp
# BREVO_API_KEY=
# BREVO_LIST_ID=
# MAILCHIMP_API_KEY=               # ends with your data centre, e.g. -us21
# MAILCHIMP_LIST_ID=
